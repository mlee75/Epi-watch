// Learn more about Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Outbreak {
  id          String   @id @default(cuid())

  // Core disease info
  disease     String
  pathogen    String?  // e.g. "Vibrio cholerae", "SARS-CoV-2"
  country     String
  region      String   // WHO region: AFRO, AMRO, EMRO, EURO, SEARO, WPRO
  subregion   String?  // City, state, province

  // Geolocation
  lat         Float?
  lng         Float?

  // Epidemiology
  cases       Int      @default(0)
  deaths      Int      @default(0)
  recovered   Int      @default(0)

  // Classification
  severity    String   @default("LOW") // CRITICAL | HIGH | MEDIUM | LOW

  // Content
  summary     String?
  trend       String?  // increasing | decreasing | stable

  // Verification & language
  verified    Boolean  @default(true)   // false = unconfirmed report
  language    String   @default("en")   // ISO 639-1 language code of source
  titleOrig   String?  // original non-English headline (before translation)

  // Source
  sourceUrl   String
  sourceName  String   // WHO | CDC | ECDC | ProMED | NewsAPI | GDELT

  // State
  isActive    Boolean  @default(true)

  // Deduplication key (disease + country + reportDate)
  dedupeKey   String   @unique

  // Timestamps
  reportDate  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sources     OutbreakSource[]
  videos      OutbreakVideo[]

  @@index([severity])
  @@index([region])
  @@index([country])
  @@index([reportDate])
  @@index([isActive])
}

model OutbreakSource {
  id               String    @id @default(cuid())
  outbreakId       String
  outbreak         Outbreak  @relation(fields: [outbreakId], references: [id], onDelete: Cascade)

  // Source identification
  sourceName       String    // e.g. "Reuters", "WHO", "Le Monde"
  sourceType       String    @default("news") // official | major-news | local-news | academic | news
  sourceLanguage   String    @default("en")
  sourceCountry    String?

  // Article details
  articleTitle     String
  articleUrl       String    @unique
  articleExcerpt   String?

  // Publication info
  publishedAt      DateTime?
  scrapedAt        DateTime  @default(now())

  // Reliability
  reliabilityScore Int       @default(3) // 1-5

  // Verification
  isVerified       Boolean   @default(false)
  verifiedBy       String?

  // Translation
  originalText     String?
  translatedText   String?

  // Metadata
  author           String?

  @@index([outbreakId])
  @@index([publishedAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// Authentication (Auth.js / NextAuth)
//
// Passwords are never stored in plaintext: `passwordHash` holds a bcrypt hash
// and is the ONLY password-shaped column. It is deliberately optional — a user
// who signs in with Google has no password at all, so there is nothing to leak
// for those accounts.
//
// Everything here is the standard Auth.js Prisma adapter shape apart from
// `passwordHash`, which the adapter does not define because the credentials
// provider is not part of the adapter contract.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  /// bcrypt hash. Null for OAuth-only accounts. Never expose over any API.
  passwordHash  String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  watchlist     WatchlistItem[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Rate-limit counters, shared across serverless instances.
///
/// The first implementation kept counts in process memory, which throttles a
/// single warm lambda rather than the fleet — an attacker hitting a cold or
/// different instance simply got a fresh budget. Storing the window in the
/// database makes the limit apply globally.
///
/// `key` is a coarse bucket (endpoint + client IP), never a password or email,
/// so this table holds no credential material.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime

  @@index([resetAt])
}

/// A disease or country a signed-in user follows. The only user-generated data
/// the app stores, kept deliberately minimal.
model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  kind      String   // "disease" | "country"
  value     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, value])
  @@index([userId])
}

/// Video intelligence sourced exclusively from allowlisted public health
/// authority channels (see lib/videoSources.ts). Every row is, by construction,
/// published by a named authority — there is no path for arbitrary internet
/// video to reach this table.
model OutbreakVideo {
  id            String    @id @default(cuid())

  // Platform identity
  platform      String    @default("youtube")
  videoId       String                        // platform-native id
  channelId     String                        // must be on the allowlist
  channelName   String
  /// Publishing body, e.g. WHO | CDC | PAHO | Reuters. The provenance label.
  authority     String
  /// authority = public health body (official guidance)
  /// news       = established newsroom (reporting, not guidance)
  /// Kept distinct so a news segment is never presented as an official position.
  sourceType    String    @default("authority")

  // Content
  title         String
  description   String?
  url           String                        // canonical watch URL
  embedUrl      String
  thumbnailUrl  String?
  language      String    @default("en")

  publishedAt   DateTime

  // Topic classification, derived from title/description by lib/feedText.
  // Null means no confident match rather than "none" — the UI must not imply
  // a video is about a disease or place we did not actually detect.
  disease       String?
  country       String?
  region        String?

  /// Set only when disease AND country both match an outbreak. A weaker link
  /// would attach official footage to events it does not discuss.
  outbreakId    String?
  outbreak      Outbreak? @relation(fields: [outbreakId], references: [id], onDelete: SetNull)

  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([platform, videoId])
  @@index([publishedAt(sort: Desc)])
  @@index([authority])
  @@index([sourceType])
  @@index([disease])
  @@index([country])
  @@index([outbreakId])
}
