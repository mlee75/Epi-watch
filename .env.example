# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# PostgreSQL connection string. The Prisma schema targets "postgresql" —
# there is no SQLite fallback. Neon (neon.tech) has a free tier.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ─────────────────────────────────────────────
# SCRAPING / CRON
# ─────────────────────────────────────────────
# Protects POST /api/scrape from unauthorized calls
SCRAPE_SECRET="change-me-to-a-random-string"

# Protects GET /api/cron/update, which Vercel Cron calls daily at 06:00 UTC
CRON_SECRET="change-me-to-a-random-string"

# ─────────────────────────────────────────────
# AI (Optional)
# ─────────────────────────────────────────────
# Richer AI summaries. Leave blank to use built-in rule-based classification.
OPENAI_API_KEY=""

# Required only by /api/travel/risk-assessment.
ANTHROPIC_API_KEY=""

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────
# Required. Signs session tokens. Generate with: openssl rand -base64 33
AUTH_SECRET=""

# Optional. Google sign-in is only offered when BOTH are set; email + password
# sign-in works without them. Create credentials at
# https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web
# application, with the redirect URI:
#   https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# SENTRY
# ─────────────────────────────────────────────
# The DSN lives in sentry.*.config.ts and is public by design. Source-map upload
# needs an auth token, supplied by the Sentry Vercel integration in production
# and by the gitignored .env.sentry-build-plugin for local builds.
